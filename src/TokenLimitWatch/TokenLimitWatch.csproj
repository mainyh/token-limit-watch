<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TokenLimitWatch</AssemblyName>
    <Product>Token Limit Watch</Product>
    <ApplicationIcon>Assets/TokenLimitWatch.ico</ApplicationIcon>
    <Version>0.2.7</Version>
    <!-- Release zip: only the exe, its config and the font license (no .pdb or package .xml docs). -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Resource Include="Assets/TokenLimitWatch.ico" />
    <Resource Include="Assets/TokenLimitWatch.png" />
    <Resource Include="Assets/Fonts/*.otf" />
    <EmbeddedResource Include="Assets/TokenLimitWatch.ico" LogicalName="TokenLimitWatch.Icon" />
    <None Update="Assets/Fonts/*LICENSE*" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../../poc/TokenLimitWatch.Poc/Models.cs" Link="Shared/Models.cs" />
    <Compile Include="../../poc/TokenLimitWatch.Poc/BrowserHost.cs" Link="Shared/BrowserHost.cs" />
    <Compile Include="../../poc/TokenLimitWatch.Poc/LoginWindow.cs" Link="Shared/LoginWindow.cs" />
    <None Include="../../poc/TokenLimitWatch.Poc/poc-config.json" Link="poc-config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
