<Application x:Class="TokenLimitWatch.Poc.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Brand" Color="#5B5BD6" />
        <SolidColorBrush x:Key="Ink" Color="#18181B" />
        <SolidColorBrush x:Key="Muted" Color="#71717A" />
        <SolidColorBrush x:Key="Line" Color="#E4E4E7" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
    </Application.Resources>
</Application>
